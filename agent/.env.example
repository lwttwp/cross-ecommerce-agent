# ============ M3 Agent 环境配置（复制为 .env 填写） ============

# --- LLM：DeepSeek（对话） ---
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding（OpenAI 兼容端点，服务器部署用；DeepSeek 无 embedding 模型） ---
# 默认硅基流动 BAAI/bge-m3（免费额度，国内直连）；也可换阿里云百炼 / 智谱 / OpenAI
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-v3

# --- 业务系统 API（PHP） ---
BIZ_API_BASE=http://127.0.0.1:8000/api/v1
BIZ_API_TOKEN_AGENT=ce_agent_xxxxxxxx
BIZ_API_TOKEN_ADMIN=ce_admin_xxxxxxxx

# --- 向量库（Chroma） ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=aftersale_policy

# --- RAG 文档目录 ---
RAG_DOCS_DIR=./src/cross_ecommerce_agent/rag/documents

# --- MCP Server（PHP，M3 中段启用） ---
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# --- 服务端口 ---
AGENT_PORT=8090

# --- 多用户与可观测（v1.1） ---
# on（默认）：聊天页复用后台登录态，未登录跳 /login；off：本地调试免登录（会打警告）
CHAT_AUTH_MODE=on
# 后台站点根地址（chat 用它调 GET /session/me 验票）；留空则从 BIZ_API_BASE 去掉 /api/v1 推导
BIZ_WEB_BASE=http://127.0.0.1:8000
# 日志服务名（结构化日志里的 service 字段）与调试级别开关
OBS_SERVICE_NAME=agent
OBS_DEBUG=0
# Prometheus 指标端点鉴权（Authorization: Bearer <token>）。
# 留空则 /metrics 一律 403 —— 该端点会经 /chat 反代暴露，不能默认公开。
METRICS_TOKEN=
