# ============ M3 Agent 环境配置（复制为 .env 填写） ============

# --- LLM：DeepSeek（对话） ---
DEEPSEEK_API_KEY=***
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Embedding（OpenAI 兼容端点，服务器部署用；DeepSeek 无 embedding 模型） ---
# 默认硅基流动 BAAI/bge-m3（免费额度，国内直连）；也可换阿里云百炼 / 智谱 / OpenAI
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-v3

# --- 业务系统 API（PHP） ---
BIZ_API_BASE=http://127.0.0.1:8000/api/v1
BIZ_API_TOKEN_AGENT=ce_agent_xxxxxxxx
BIZ_API_TOKEN_ADMIN=ce_admin_xxxxxxxx

# --- 向量库（Chroma） ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=aftersale_policy

# --- RAG 文档目录 ---
RAG_DOCS_DIR=./src/cross_ecommerce_agent/rag/documents

# --- MCP Server（PHP，M3 中段启用） ---
MCP_SERVER_URL=http://127.0.0.1:8080/mcp

# --- 服务端口 ---
AGENT_PORT=8090
